---
import { getEntry, render } from 'astro:content';
import DocumentLayout from '../layouts/document-layout.astro';

const entry = await getEntry('docs', 'rules');

if (!entry) {
    throw new Error('내전 규칙 문서를 찾을 수 없습니다.');
}

const { Content, headings } = await render(entry);
---

<DocumentLayout {...entry.data} headings={headings}>
    <Content />
</DocumentLayout>
