---
import BaseLayout from '../layouts/base-layout.astro';
import { withBase } from '../lib/site';

const sections = [
    {
        title: '내전 규칙',
        description: '허용되는 플레이와 금지되는 행동, 경고 기준을 확인합니다.',
        href: '/rules',
    },
    {
        title: '자주 묻는 질문',
        description: '포커싱, 전술 콜, 밸런스 의견처럼 애매한 상황을 사례로 설명합니다.',
        href: '/faq',
    },
    {
        title: '참가 안내',
        description: '신청부터 배틀태그 작성, 초대 설정, 불참 연락까지 한 번에 확인합니다.',
        href: '/participation',
    },
];
---

<BaseLayout>
    <section class="home-index">
        <div class="container home-index__inner">
            <header class="home-index__header">
                <p class="eyebrow">OWKR 내전 가이드</p>
                <h1>내전 운영 문서</h1>
                <p>규칙, 참가 절차, 자주 묻는 질문을 확인하세요.</p>
            </header>

            <nav class="home-index__links" aria-label="문서 바로가기">
                {
                    sections.map((section) => (
                        <a class="home-index__link" href={withBase(section.href)}>
                            <div>
                                <h2>{section.title}</h2>
                                <p>{section.description}</p>
                            </div>
                            <span aria-hidden="true">→</span>
                        </a>
                    ))
                }
            </nav>
        </div>
    </section>
</BaseLayout>
