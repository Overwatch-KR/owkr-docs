---
import { getEntry, render } from 'astro:content';
import DocumentLayout from '../layouts/document-layout.astro';

const entry = await getEntry('docs', 'participant-privacy');

if (!entry) {
    throw new Error('내전 참가자 개인정보 수집·이용 안내 문서를 찾을 수 없습니다.');
}

const { Content } = await render(entry);
---

<DocumentLayout {...entry.data}>
    <Content />
</DocumentLayout>
