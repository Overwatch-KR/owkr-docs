---
import { Image } from 'astro:assets';
import botIcon from '../../assets/bot-icon.png';
import { getEntry, render } from 'astro:content';
import DocumentHeader from '../../components/document-header.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { withBase } from '../../lib/site';
import { getPolicyDocuments, formatPolicyDate } from '../../lib/policies';
import '../../styles/policy.css';
const entry = await getEntry('docs', 'gather-bot');
if (!entry) throw new Error('봇 정책 안내를 찾을 수 없습니다.');
const { Content } = await render(entry);
const documents = await getPolicyDocuments();
---
<BaseLayout title={entry.data.title} description={entry.data.description} section="bot">
    <DocumentHeader title="시간을달리는소녀" label="OWKR Discord 내전 운영 봇" description="이용약관, 개인정보처리방침과 문의·삭제 요청 안내를 확인하세요." publishedAt={entry.data.publishedAt} updatedAt={entry.data.updatedAt}>
        <Image slot="illustration" src={botIcon} alt="시간을달리는소녀 봇 아이콘" width={112} height={112} format="webp" loading="eager" fetchpriority="high" />
    </DocumentHeader>
    <div class="container policy-home">
        <section aria-labelledby="policy-documents-title">
            <div class="policy-section-heading"><h2 id="policy-documents-title">어떤 안내가 필요하신가요?</h2><span>문서별로 바로 확인하세요</span></div>
            <div class="policy-cards">{documents.map(({ slug, title, summary, action, entry: document }, index) => <a class="policy-card" href={withBase(`/gather-bot/${slug}`)}><div class="policy-card__top"><span class="policy-card__number">0{index + 1}</span></div><h3>{title}</h3><p>{summary}</p><span class="policy-card__action">{action}<span aria-hidden="true">↗</span></span><small>최근 갱신 {formatPolicyDate(document.data.updatedAt)} · v{document.data.version}</small></a>)}</div>
            <p class="policy-status-note">무료 커뮤니티 봇의 이용 안내입니다. 개인정보가 포함된 문의는 운영자에게 비공개로 보내 주세요.</p>
        </section>
        <a class="policy-history-banner" href={withBase('/gather-bot/changes')}><div><strong>어떤 내용이 바뀌었나요?</strong><span>발행 기록과 이전 문구·바뀐 문구를 비교해 보세요.</span></div><span>문서 변경 이력 ↗</span></a>
        <section class="policy-help" aria-labelledby="policy-help-title"><div><p class="policy-eyebrow">문의·오류 신고</p><h2 id="policy-help-title">도움이 필요하신가요?</h2><p>개인정보가 포함된 문의는 공개 채널 대신<br />운영 담당자에게 비공개로 보내 주세요.</p></div><div class="policy-help__contact"><a href="mailto:qtaghdi@gmail.com">이메일로 문의하기 <span aria-hidden="true">↗</span></a><span>qtaghdi@gmail.com</span><span>Discord 비공개 메시지 · qtaghdi</span></div></section>
        <section class="policy-about"><div><h2>이 안내는 봇 이용에 관한 문서입니다.</h2><div class="policy-about__copy"><Content /></div></div><a href={withBase('/participant-privacy')}>참가자·팀 밸런스 개인정보 안내 ↗</a></section>
    </div>
</BaseLayout>
