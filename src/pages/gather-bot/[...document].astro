---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PolicyLayout from '../../layouts/policy-layout.astro';

export async function getStaticPaths() {
    const entries = await getCollection('docs', ({ id }) => id.startsWith('gather-bot/'));
    return entries.map((entry) => ({
        params: { document: entry.id.slice('gather-bot/'.length) },
        props: { entry },
    }));
}

interface Props {
    entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<PolicyLayout {...entry.data} slug={entry.id.slice('gather-bot/'.length)} headings={headings}>
    <Content />
</PolicyLayout>
