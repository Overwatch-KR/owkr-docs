---
import { getEntry, render } from 'astro:content';
import DocumentLayout from '../layouts/document-layout.astro';

const entry = await getEntry('changelog', 'changelog');

if (!entry) {
    throw new Error('변경 이력 문서를 찾을 수 없습니다.');
}

const { Content } = await render(entry);
---

<DocumentLayout {...entry.data}>
    <Content />
</DocumentLayout>
