---
import { withBase } from '../lib/site';
import { formatPolicyDate } from '../lib/policies';
interface Props {
    title: string;
    description: string;
    label: string;
    status?: 'draft' | 'active' | 'archived';
    version?: string;
    publishedAt?: Date;
    updatedAt?: Date;
    historyHref?: string;
}
const { title, description, label, version, publishedAt, updatedAt, historyHref } = Astro.props;
const isBotPage = Astro.url.pathname.includes('/gather-bot');
---
<section class="doc-hero">
    <div class="container doc-hero__inner">
        <nav class="document-navigation" aria-label="안내 홈 선택">
            <a href={withBase('/')} aria-current={!isBotPage ? 'location' : undefined}>내전 가이드</a>
            <a href={withBase('/gather-bot')} aria-current={isBotPage ? 'location' : undefined}>봇 정책·지원</a>
        </nav>
        <header class="document-header">
            <div class="document-header__intro">
                <div class="document-header__copy">
                    <div class="document-header__label"><p class="eyebrow">{label.split(' · ')[0]}</p></div>
                    <h1>{title}</h1>
                    <p class="doc-hero__description">{description}</p>
                </div>
                {Astro.slots.has('illustration') && <div class="document-header__illustration"><slot name="illustration" /></div>}
            </div>
            {(publishedAt || updatedAt || version) && <dl class="document-meta" aria-label="문서 정보">
                {publishedAt && <div><dt>최초 발행일</dt><dd><time datetime={publishedAt.toISOString()}>{formatPolicyDate(publishedAt)}</time></dd></div>}
                {updatedAt && <div><dt>최근 갱신일</dt><dd><time datetime={updatedAt.toISOString()}>{formatPolicyDate(updatedAt)}</time></dd></div>}
                {version && <div><dt>버전</dt><dd>{version}</dd></div>}
            </dl>}
            {historyHref && <a class="document-history-link" href={historyHref}>이 문서의 변경 내용 비교 →</a>}
        </header>
    </div>
</section>
