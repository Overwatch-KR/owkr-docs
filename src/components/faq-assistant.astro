---
import { getCollection, render } from 'astro:content';
import { withBase } from '../lib/site';
import FaqAssistantCharacter from './faq-assistant-character.astro';

const CATEGORY_ORDER = ['참가', '게임 진행', '커뮤니케이션', '경고와 제재'] as const;
const entries = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
const items = await Promise.all(
    entries.map(async (entry) => {
        const { Content } = await render(entry);

        return { entry, Content };
    }),
);
---

<div class="faq-assistant" data-faq-assistant data-state="closed">
    <button
        class="faq-assistant__trigger"
        type="button"
        aria-expanded="false"
        aria-controls="faq-assistant-dialog"
        data-assistant-trigger
    >
        <FaqAssistantCharacter size="small" />
        <span class="faq-assistant__trigger-copy">
            <strong>규칙 도우미</strong>
            <span>궁금한 점 물어보기</span>
        </span>
    </button>

    <button
        class="faq-assistant__backdrop"
        type="button"
        tabindex="-1"
        aria-label="규칙 도우미 닫기"
        data-assistant-close
    ></button>

    <section
        class="faq-assistant__panel"
        id="faq-assistant-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="faq-assistant-title"
        aria-hidden="true"
        inert
        data-assistant-panel
    >
        <header class="faq-assistant__header">
            <div class="faq-assistant__profile">
                <FaqAssistantCharacter size="small" />
                <div class="faq-assistant__identity">
                    <h2 id="faq-assistant-title">OWKR 규칙 도우미</h2>
                    <p><span aria-hidden="true"></span> 바로 답변할게요</p>
                </div>
            </div>
            <button
                class="faq-assistant__close"
                type="button"
                aria-label="규칙 도우미 닫기"
                data-assistant-close
            >
                <span aria-hidden="true"></span>
            </button>
        </header>

        <div class="faq-assistant__body" data-assistant-scroll>
            <div
                class="faq-assistant__conversation"
                aria-live="polite"
                aria-label="규칙 도우미 대화"
            >
                <div class="faq-assistant__message faq-assistant__message--bot">
                    <FaqAssistantCharacter size="small" />
                    <div class="faq-assistant__message-content">
                        <span class="faq-assistant__speaker">OWKR 도우미</span>
                        <div class="faq-assistant__bubble faq-assistant__bubble--bot">
                            <p>안녕하세요! 내전 규칙에서 궁금한 내용을 함께 찾아드릴게요.</p>
                            <p>먼저 확인하려는 주제를 골라 주세요.</p>
                        </div>
                    </div>
                </div>

                <div
                    class="faq-assistant__categories faq-assistant__quick-replies"
                    aria-label="FAQ 주제"
                    data-assistant-category-options
                >
                    {
                        CATEGORY_ORDER.map((category) => (
                            <button
                                type="button"
                                aria-pressed="false"
                                data-assistant-category={category}
                            >
                                {category}
                            </button>
                        ))
                    }
                </div>

                <div
                    class="faq-assistant__message faq-assistant__message--user"
                    hidden
                    data-assistant-category-message
                >
                    <div class="faq-assistant__bubble faq-assistant__bubble--user">
                        <p data-assistant-selected-category></p>
                    </div>
                </div>

                <div
                    class="faq-assistant__message faq-assistant__message--bot"
                    hidden
                    data-assistant-questions
                >
                    <FaqAssistantCharacter size="small" />
                    <div class="faq-assistant__message-content">
                        <span class="faq-assistant__speaker">OWKR 도우미</span>
                        <div class="faq-assistant__bubble faq-assistant__bubble--bot">
                            <p>
                                <strong data-assistant-selected-category-label></strong> 관련
                                질문이에요. 궁금한 내용을 골라 주세요.
                            </p>
                        </div>
                        <div
                            class="faq-assistant__question-list faq-assistant__quick-replies"
                            data-assistant-question-options
                        >
                            {
                                items.map(({ entry }) => (
                                    <button
                                        type="button"
                                        data-assistant-question={entry.id}
                                        data-category={entry.data.category}
                                        hidden
                                    >
                                        <span>{entry.data.question}</span>
                                        <span aria-hidden="true">→</span>
                                    </button>
                                ))
                            }
                        </div>
                    </div>
                </div>

                <div
                    class="faq-assistant__message faq-assistant__message--user"
                    hidden
                    data-assistant-question-message
                >
                    <div class="faq-assistant__bubble faq-assistant__bubble--user">
                        <p
                            class="faq-assistant__selected-question"
                            data-assistant-selected-question
                        >
                        </p>
                    </div>
                </div>

                <div
                    class="faq-assistant__message faq-assistant__message--bot"
                    hidden
                    data-assistant-answer-view
                >
                    <FaqAssistantCharacter size="small" />
                    <div class="faq-assistant__message-content">
                        <span class="faq-assistant__speaker">OWKR 도우미</span>
                        <div class="faq-assistant__bubble faq-assistant__bubble--bot">
                            {
                                items.map(({ entry, Content }) => (
                                    <article
                                        class="faq-assistant__answer"
                                        data-assistant-answer={entry.id}
                                        hidden
                                    >
                                        <Content />
                                    </article>
                                ))
                            }
                        </div>
                    </div>
                </div>

                <div
                    class="faq-assistant__follow-ups faq-assistant__quick-replies"
                    hidden
                    data-assistant-follow-ups
                >
                    <button class="faq-assistant__back" type="button" data-assistant-back>
                        다른 질문 보기
                    </button>
                    <button class="faq-assistant__restart" type="button" data-assistant-restart>
                        주제 바꾸기
                    </button>
                </div>
            </div>
        </div>

        <footer class="faq-assistant__footer">
            <span>정식 규칙이 우선 적용됩니다.</span>
            <a href={withBase('/rules')}>규칙 전문 보기</a>
        </footer>
    </section>
</div>

<script>
    import '../scripts/faq-assistant';
</script>
