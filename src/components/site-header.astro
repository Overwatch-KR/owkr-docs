---
import { withBase } from '../lib/site';

interface Props {
    currentPath: string;
}

interface NavigationItem {
    href: string;
    label: string;
}

const { currentPath } = Astro.props;
const navigation: NavigationItem[] = [
    { href: '/rules', label: '내전 규칙' },
    { href: '/faq', label: 'FAQ' },
    { href: '/participation', label: '참가 안내' },
];
const isActive = (href: string) => currentPath === withBase(href);
---

<header class="site-header">
    <div class="container site-header__inner">
        <a class="brand" href={withBase('/')} aria-label="OWKR 내전 운영 가이드 홈">
            <strong>OWKR</strong>
            <span>내전 가이드</span>
        </a>

        <div class="site-header__actions">
            <nav class="site-nav" aria-label="주요 메뉴">
                {
                    navigation.map((item) => (
                        <a
                            href={withBase(item.href)}
                            class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
                            aria-current={isActive(item.href) ? 'page' : undefined}
                        >
                            {item.label}
                        </a>
                    ))
                }
            </nav>
            <button
                class="theme-toggle"
                type="button"
                role="switch"
                aria-label="다크 테마"
                aria-checked="false"
                title="다크 테마로 전환"
                data-theme-toggle
            >
                <span class="theme-toggle__track" aria-hidden="true">
                    <svg class="theme-toggle__icon theme-toggle__icon--light" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="4"></circle>
                        <path d="M3 12h1m8-9v1m8 8h1m-9 8v1M5.6 5.6l.7.7m12.1-.7-.7.7m0 11.4.7.7m-12.1-.7-.7.7"></path>
                    </svg>
                    <svg class="theme-toggle__icon theme-toggle__icon--dark" viewBox="0 0 24 24">
                        <path d="M12 3h.393a7.5 7.5 0 0 0 7.92 12.446A9 9 0 1 1 12 2.992Z"></path>
                    </svg>
                    <span class="theme-toggle__thumb"></span>
                </span>
            </button>
        </div>
    </div>
</header>

<script>
    import '../scripts/theme-toggle';
</script>
