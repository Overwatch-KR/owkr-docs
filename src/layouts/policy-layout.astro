---
import DocumentHeader from '../components/document-header.astro';
import BaseLayout from './base-layout.astro';
import DocumentToc from '../components/document-toc.astro';
import PolicyNavigation from '../components/policy-navigation.astro';
import { withBase } from '../lib/site';
import { POLICY_LINKS } from '../lib/policies';
import '../styles/policy.css';
interface Props {
    slug: string;
    title: string;
    description: string;
    status: 'draft' | 'active' | 'archived';
    version: string;
    publishedAt?: Date;
    updatedAt: Date;
    headings: { depth: number; slug: string; text: string }[];
}
const { slug, title, description, status, version, publishedAt, updatedAt, headings } = Astro.props;
if (!publishedAt) throw new Error(`최초 발행일 누락: ${slug}`);
const shortTitle = POLICY_LINKS.find((link) => link.slug === slug)?.title ?? title;
---
<BaseLayout title={title} description={description} noindex={status === 'draft'} section="bot">
    <DocumentHeader title={shortTitle} {description} label="시간을달리는소녀" {status} {version} {publishedAt} {updatedAt} historyHref={withBase(`/gather-bot/changes#${slug}`)}>
        <PolicyNavigation slot="navigation" current={slug} />
    </DocumentHeader>
    <div class="container document-grid">
        <DocumentToc headings={headings} />
        <div class="policy-reading">
            <article class="prose"><slot /></article>
            <a class="policy-back policy-back--bottom" href={withBase('/gather-bot')}>← 다른 정책·지원 안내 보기</a>
        </div>
    </div>
</BaseLayout>
