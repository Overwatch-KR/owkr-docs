---
import BaseLayout from './base-layout.astro';
import { withBase } from '../lib/site';

interface Props {
    title: string;
    description: string;
    label: string;
    updatedAt: Date;
    showSidebar?: boolean;
    headings?: DocumentHeading[];
}

interface DocumentHeading {
    depth: number;
    slug: string;
    text: string;
}

const { title, description, label, updatedAt, showSidebar = true, headings = [] } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('ko-KR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
}).format(updatedAt);
const sectionHeadings = headings.filter((heading) => heading.depth === 2);
const showTableOfContents = showSidebar && sectionHeadings.length > 0;
const getSectionLabel = (heading: DocumentHeading) => heading.text.replace(/^\d+\.\s*/, '');
---

<BaseLayout title={title} description={description}>
    <section class="doc-hero">
        <div class="container doc-hero__inner">
            <a class="eyebrow-link" href={withBase('/')}>OWKR 내전 운영 가이드</a>
            <div class="doc-hero__heading">
                <div>
                    <p class="eyebrow">{label}</p>
                    <h1>{title}</h1>
                    <p class="doc-hero__description">{description}</p>
                </div>
            </div>
            <div class="doc-meta" aria-label="문서 정보">
                <span>최종 수정일: {formattedDate}</span>
            </div>
        </div>
    </section>

    <div
        class:list={[
            'container',
            'document-grid',
            { 'document-grid--single': !showTableOfContents },
        ]}
    >
        {
            showTableOfContents && (
                <aside class="document-toc" aria-label="문서 목차" data-document-toc>
                    <p class="document-toc__label">이 문서에서</p>
                    <nav>
                        {sectionHeadings.map((heading, index) => (
                            <a href={`#${heading.slug}`} data-document-toc-link={heading.slug}>
                                <span aria-hidden="true">
                                    {String(index + 1).padStart(2, '0')}
                                </span>
                                <span>{getSectionLabel(heading)}</span>
                            </a>
                        ))}
                    </nav>
                </aside>
            )
        }
        <article class="prose">
            <slot />
        </article>
    </div>
    <script>
        import '../scripts/document-toc';
    </script>
</BaseLayout>
