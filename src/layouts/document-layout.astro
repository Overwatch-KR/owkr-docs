---
import BaseLayout from './base-layout.astro';
import DocumentHeader from '../components/document-header.astro';
import DocumentToc from '../components/document-toc.astro';

interface Props {
    status?: 'draft' | 'active' | 'archived';
    title: string;
    description: string;
    label: string;
    updatedAt: Date;
    publishedAt?: Date;
    version?: string;
    showSidebar?: boolean;
    headings?: DocumentHeading[];
}

interface DocumentHeading {
    depth: number;
    slug: string;
    text: string;
}

const { status = 'active', title, description, label, updatedAt, publishedAt, version, showSidebar = true, headings = [] } = Astro.props;
const sectionHeadings = headings.filter((heading) => heading.depth === 2);
const showTableOfContents = showSidebar && sectionHeadings.length > 0;
---

<BaseLayout title={title} description={description} noindex={status === 'draft'}>
    <DocumentHeader {title} {description} {label} {status} {version} {publishedAt} {updatedAt} />

    <div
        class:list={[
            'container',
            'document-grid',
            { 'document-grid--single': !showTableOfContents },
        ]}
    >
        {
            showTableOfContents && (
                <DocumentToc headings={headings} />
            )
        }
        <article class="prose">
            <slot />
        </article>
    </div>
</BaseLayout>
