---
import BaseLayout from './base-layout.astro';
import DocumentToc from '../components/document-toc.astro';
import { withBase } from '../lib/site';

interface Props {
    status?: 'draft' | 'active' | 'archived';
    title: string;
    description: string;
    label: string;
    updatedAt: Date;
    showSidebar?: boolean;
    headings?: DocumentHeading[];
}

interface DocumentHeading {
    depth: number;
    slug: string;
    text: string;
}

const { status = 'active', title, description, label, updatedAt, showSidebar = true, headings = [] } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('ko-KR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
}).format(updatedAt);
const sectionHeadings = headings.filter((heading) => heading.depth === 2);
const showTableOfContents = showSidebar && sectionHeadings.length > 0;
---

<BaseLayout title={title} description={description} noindex={status === 'draft'}>
    <section class="doc-hero">
        <div class="container doc-hero__inner">
            <a class="eyebrow-link" href={withBase('/')}>OWKR 내전 운영 가이드</a>
            <div class="doc-hero__heading">
                <div>
                    <p class="eyebrow">{label}</p>
                    <h1>{title}</h1>
                    <p class="doc-hero__description">{description}</p>
                </div>
            </div>
            <div class="doc-meta" aria-label="문서 정보">
                {status === 'draft' && <strong>검토 중 초안 · 시행일 미정</strong>}
                <span>최종 수정일: {formattedDate}</span>
            </div>
        </div>
    </section>

    <div
        class:list={[
            'container',
            'document-grid',
            { 'document-grid--single': !showTableOfContents },
        ]}
    >
        {
            showTableOfContents && (
                <DocumentToc headings={headings} />
            )
        }
        <article class="prose">
            <slot />
        </article>
    </div>
</BaseLayout>
